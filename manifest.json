{
  "manifest_version": 3,
  "name": "WebMorph — Universal Web Agent",
  "version": "1.0.0",
  "description": "Morph any messy website into a clean, accessible, dark-pattern-free guided flow with live DOM sync.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://api.groq.com/*",
    "https://api.x.ai/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Activate WebMorph"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-webmorph": {
      "suggested_key": {
        "default": "Alt+M"
      },
      "description": "Toggle WebMorph on current page"
    }
  }
}
